# Copy to .env and fill in. NEVER commit .env (see .gitignore).

# --- LLM / agent keys ---
ANTHROPIC_API_KEY=sk-ant-...
FACTORY_API_KEY=fk-...
# Exploit-PoC generation (GENERATE) is provider-agnostic (OpenAI-compatible).
# Bitdeer is PRIMARY (sponsor serving our DeepSeek exploit-author model);
# Featherless is the secondary hot standby; both host the same
# deepseek-ai/DeepSeek-V4.1-Flash-1017. If neither key is set, a cached PoC is used.
FEATHERLESS_API_KEY=...
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
BITDEER_API_KEY=...
BITDEER_BASE_URL=https://api-inference.bitdeer.ai/v1
NVD_API_KEY=                        # optional; sent as HTTP header "apiKey:" (NOT a query param)

# --- device service (host) ---
# NOTE: default is 8071, NOT 5000 — on macOS, port 5000 is taken by the AirPlay
# Receiver (ControlCenter), which answers 403 and would masquerade as our
# service (a false VERIFY pass). Keep 8071, or disable AirPlay Receiver in
# System Settings > General > AirDrop & Handoff if you must use 5000.
DEVICE_SERVICE_URL=http://127.0.0.1:8071
DEVICE_SERVICE_PORT=8071
SANDBOX_ALLOWLIST=127.0.0.1,localhost
# The bearer token the PATCHED device-service requires (set by the loop when it
# brings up the patched service; any non-empty value works for the demo).
DEVICE_SERVICE_TOKEN=prevent-demo-token

# --- Fetch.ai / ASI:One uAgent (fetch_agent/) ---
ASI_ONE_API_KEY=                    # from asi1.ai (OpenAI-compatible); only needed when run outside Agentverse
ASI_ONE_BASE_URL=https://api.asi1.ai/v1
AGENT_SEED=                         # UNIQUE secret phrase -> stable agent1q... address; never commit
PREVENT_AGENT_NAME=PreVent-Security
PREVENT_AGENT_PORT=8101
# Optional. From Agentverse → Settings → API keys. Required to list agents on your account.
ILABS_AGENTVERSE_API_KEY=
# Extra agents in fetch_agent/team/. Each seed must be unique. Leave peer addresses
# empty to derive them from the matching seed.
RC_AGENT_SEED=
RC_AGENT_NAME=Release-Captain
RC_AGENT_PORT=8102
PREVENT_PEER_ADDRESS=
RC_PEER_ADDRESS=
WARD_AGENT_SEED=
WARD_AGENT_NAME=Ward-Orchestrator
WARD_AGENT_PORT=8100
BENCH_AGENT_SEED=
BENCH_AGENT_NAME=Bench-Monitor
BENCH_AGENT_PORT=8103
BENCH_STATUS_URL=http://127.0.0.1:8000/api/status
EVIDENCE_AGENT_SEED=
EVIDENCE_AGENT_NAME=Evidence-Clerk
EVIDENCE_AGENT_PORT=8104
PATIENT_AGENT_SEED=
PATIENT_AGENT_NAME=Patient-Risk
PATIENT_AGENT_PORT=8105
REVIEW_AGENT_SEED=
REVIEW_AGENT_NAME=Patch-Reviewer
REVIEW_AGENT_PORT=8106
KNOWLEDGE_AGENT_SEED=
KNOWLEDGE_AGENT_NAME=CVE-Knowledge
KNOWLEDGE_AGENT_PORT=8107

# --- hardware ---
ARDUINO_SERIAL_PORT=COM3

# --- realtime backend (spacetimedb | convex) ---
VITE_REALTIME_BACKEND=spacetimedb
VITE_SPACETIMEDB_URI=ws://localhost:3000
VITE_SPACETIMEDB_MODULE=prevent
VITE_CONVEX_URL=
